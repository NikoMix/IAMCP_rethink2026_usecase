<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone proof of concept for ADR 0001. Not part of any solution.
    Self-contained on purpose: no central package management, no repository-wide build files.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Lets the PoC run on machines that only have a newer .NET runtime installed. -->
    <RollForward>Major</RollForward>
    <RootNamespace>Adr0001.Poc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.4.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sample-data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
