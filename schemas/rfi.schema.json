{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NikoMix/IAMCP_rethink2026_usecase/main/schemas/rfi.schema.json",
  "title": "Request for Information / Expression of Interest (RFI)",
  "description": "Data for templates/rfi.md. The customer is the issuer; there is no supplier yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "customer", "project", "rfi"],
  "properties": {
    "$schema": { "type": "string" },
    "document": {
      "$ref": "common.schema.json#/$defs/document",
      "properties": { "type": { "const": "rfi" } }
    },
    "customer": {
      "$ref": "common.schema.json#/$defs/party",
      "required": ["name", "contact"],
      "properties": {
        "contact": {
          "$ref": "common.schema.json#/$defs/contact",
          "required": ["name", "email"]
        }
      }
    },
    "project": {
      "$ref": "common.schema.json#/$defs/project",
      "required": ["name", "summary"]
    },
    "rfi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_deadline", "questions"],
      "properties": {
        "response_deadline": { "$ref": "common.schema.json#/$defs/date" },
        "questions_deadline": { "$ref": "common.schema.json#/$defs/date" },
        "purposes": { "$ref": "common.schema.json#/$defs/textList" },
        "areas_of_interest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
              "title": { "$ref": "common.schema.json#/$defs/text" },
              "description": { "$ref": "common.schema.json#/$defs/text" }
            }
          }
        },
        "region": { "$ref": "common.schema.json#/$defs/text" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "$ref": "common.schema.json#/$defs/text" },
              "guidance": { "$ref": "common.schema.json#/$defs/text" }
            }
          }
        },
        "response_format": { "$ref": "common.schema.json#/$defs/text" },
        "timeline": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/milestone" }
        }
      }
    }
  }
}
